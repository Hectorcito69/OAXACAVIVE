---
import Layout from "../layouts/Layout.astro";
import EventCard from "../components/EventCard.astro";
import { eventos } from "../data/eventos.js";
---

<Layout
  title="Inicio"
  description="Oaxaca Vive es un espectáculo cultural multidisciplinario que fusiona música, danza, teatro y artes visuales. Vive una noche inolvidable celebrando la grandeza del talento oaxaqueño."
>
  <section class="hero">
    <video class="hero-video" autoplay loop muted playsinline>
      <source src="/video/Oaxcpage.mp4" type="video/mp4" />
    </video>
<section class="separador-greca" aria-hidden="true"></section>
    <div class="hero-overlay"></div>

    <div class="hero-info">
     
      <img src="/images/papel-picado.png" alt="" class="hero-papelpicado" />
      <h1 class="hero-title">Un festival para los sentidos</h1>
      <p class="hero-subtitle">
        Vive una noche única donde la música, la danza y la magia escénica se
        unen en un show que honra el talento y la cultura de Oaxaca.
      </p>
      <a
        href="https://www.instagram.com/oaxacaviveshow"
        target="_blank"
        rel="noopener"
        class="btn btn-primary">Conócenos</a
      >
    </div>
  </section>

 

  <section class="sobre-oaxaca container">
    <div class="sobre-oaxaca-grid">
      <img
        src="/images/danzante.jpg"
        alt="Danzante tradicional de Oaxaca"
        class="reveal"
        loading="lazy"
        width="500"
        height="620"
      />
      <div class="reveal reveal-delay-1">
        <img
          src="/images/adorno-flores.png"
          alt=""
          class="adorno-pequeño"
          width="70"
          height="70"
        />
        <h2>Oaxaca Vive</h2>
        <p>
          Oaxaca Vive es más que un evento: es una experiencia cultural que
          reúne lo mejor de las artes escénicas en un solo escenario.
        </p>
        <blockquote class="sobre-oaxaca-cita">
          "Un encuentro con la cultura, la música y la emoción"
        </blockquote>
        <p>
          Desde el poder de las voces de grandes tenores hasta la energía
          vibrante del jazz y las percusiones, pasando por la elegancia de
          cuartetos y orquestas, y el asombro de la danza aérea, cada
          presentación lleva al público a un viaje inolvidable.
        </p>
        <p>
          Te invitamos a ser parte de este evento que reúne tradición,
          innovación y talento: un espacio para celebrar el arte y
          compartirlo con la comunidad.
        </p>
      </div>
      <img
        src="/images/galeria-4.jpg"
        alt="Artista de Oaxaca Vive en escena"
        class="reveal reveal-delay-2"
        loading="lazy"
        width="500"
        height="620"
      />
    </div>
  </section>

  <section class="eventos">
   

    <div class="eventos-header">
      <h2 class="reveal">Próximos eventos</h2>
    </div>
    <div class="eventos-grid">
      {eventos.map((evento, i) => <EventCard {...evento} index={i} />)}
    </div>
  </section>

  <section class="galeria container">
    <h2 class="reveal">Galería</h2>
    <div class="galeria-principal">
      <img id="galeria-img-principal" src="/images/galeria-1.jpg" alt="Imagen destacada de la galería" />
    </div>
    <div class="galeria-thumbs">
      <img class="galeria-thumb" src="/images/galeria-grande.jpg" alt="Miniatura 1" loading="lazy" />
      <img class="galeria-thumb" src="/images/galeria-chica-1.jpg" alt="Miniatura 2" loading="lazy" />
      <img class="galeria-thumb" src="/images/galeria-chica-3.jpg" alt="Miniatura 3" loading="lazy" />
      <img class="galeria-thumb" src="/images/galeria-chica-2.jpg" alt="Miniatura 4" loading="lazy" />
      <img class="galeria-thumb" src="/images/galeria-chica-5.jpg" alt="Miniatura 5" loading="lazy" />
    </div>
  </section>

  <section class="separador-video">
    <video class="separador-video-bg" autoplay loop muted playsinline>
      <source src="/video/high-teatro.mp4" type="video/mp4" />
    </video>
    <div class="separador-video-overlay"></div>
    <h2 class="separador-video-texto">
      Un encuentro donde las raíces se hermanan y festejan.
    </h2>
  </section>



  <section
    class="frame-fiesta"
    style="background-image: url('/images/stage-bg.jpg');"
  >
    <div class="frame-fiesta-contenido">
      <h2>"Vive la cultura, únete a la fiesta"</h2>
      <a
        href="https://www.instagram.com/oaxacaviveshow"
        target="_blank"
        rel="noopener"
        class="btn btn-secondary">Conócenos</a
      >
    </div>
  </section>
</Layout>

<script>
  function initGaleria() {
    const principal = document.getElementById(
      "galeria-img-principal"
    ) as HTMLImageElement | null;
    const thumbs = document.querySelectorAll<HTMLImageElement>(".galeria-thumb");
    if (!principal || thumbs.length === 0) return;

    thumbs[0].classList.add("selected");

    thumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        principal.src = thumb.src;
        thumbs.forEach((t) => t.classList.remove("selected"));
        thumb.classList.add("selected");
      });
    });
  }

  document.addEventListener("astro:page-load", initGaleria);
</script>
