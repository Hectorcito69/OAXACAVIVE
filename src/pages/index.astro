---
import Layout from "../layouts/Layout.astro";
import EventCard from "../components/EventCard.astro";
import { eventos } from "../data/eventos.js";
---

<Layout
  title="Inicio"
  description="Oaxaca Vive es un espectáculo cultural multidisciplinario que fusiona música, danza, teatro y artes visuales. Vive una noche inolvidable celebrando la grandeza del talento oaxaqueño."
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/galeria-4.jpg" fetchpriority="high" />
  </Fragment>

  <section class="hero-video-only" aria-label="Video principal Oaxaca Vive">
    <video
      id="hero-main-video"
      class="hero-video"
      autoplay
      loop
      muted
      playsinline
      preload="metadata"
      poster="/images/galeria-4.jpg"
      src="/video/Oaxcpage.mp4"
    >
      <source src="/video/Oaxcpage.mp4" type="video/mp4" />
    </video>
  </section>

  <section class="separador-greca" aria-hidden="true"></section>

  <section class="hero-intro">
    <div class="hero-info">
      <img src="/images/papel-picado.png" alt="" class="hero-papelpicado" />
      <h1 class="hero-title">Un festival para los sentidos</h1>
      <p class="hero-subtitle">
        Vive una noche única donde la música, la danza y la magia escénica se
        unen en un show que honra el talento y la cultura de Oaxaca.
      </p>
      <a
        href="https://www.instagram.com/oaxacaviveshow"
        target="_blank"
        rel="noopener"
        class="btn btn-primary">Conócenos</a
      >
    </div>
  </section>

 

  <section class="sobre-oaxaca container">
    <div class="sobre-oaxaca-grid">
      <img
        src="/images/danzante.jpg"
        alt="Danzante tradicional de Oaxaca"
        class="reveal"
        loading="lazy"
        width="500"
        height="620"
      />
      <div class="reveal reveal-delay-1">
        <img
          src="/images/adorno-flores.png"
          alt=""
          class="adorno-pequeño"
          width="70"
          height="70"
        />
        <h2>Oaxaca Vive</h2>
        <p>
          Oaxaca Vive es más que un evento: es una experiencia cultural que
          reúne lo mejor de las artes escénicas en un solo escenario.
        </p>
        <blockquote class="sobre-oaxaca-cita">
          "Un encuentro con la cultura, la música y la emoción"
        </blockquote>
        <p>
          Desde el poder de las voces de grandes tenores hasta la energía
          vibrante del jazz y las percusiones, pasando por la elegancia de
          cuartetos y orquestas, y el asombro de la danza aérea, cada
          presentación lleva al público a un viaje inolvidable.
        </p>
        <p>
          Te invitamos a ser parte de este evento que reúne tradición,
          innovación y talento: un espacio para celebrar el arte y
          compartirlo con la comunidad.
        </p>
      </div>
      <img
        src="/images/galeria-4.jpg"
        alt="Artista de Oaxaca Vive en escena"
        class="reveal reveal-delay-2"
        loading="lazy"
        width="500"
        height="620"
      />
    </div>
  </section>

  <section class="eventos">
   

    <div class="eventos-header">
      <h2 class="reveal">Próximos eventos</h2>
    </div>
    <div class="eventos-grid">
      {eventos.map((evento, i) => <EventCard {...evento} index={i} />)}
    </div>
  </section>

  <section class="galeria container">
    <h2 class="reveal">Galería</h2>
    <div class="galeria-principal">
      <img id="galeria-img-principal" src="/images/galeria-1.jpg" alt="Imagen destacada de la galería" />
    </div>
    <div class="galeria-thumbs">
      <img class="galeria-thumb" src="/images/galeria-grande.jpg" alt="Miniatura 1" loading="lazy" />
      <img class="galeria-thumb" src="/images/galeria-chica-1.jpg" alt="Miniatura 2" loading="lazy" />
      <img class="galeria-thumb" src="/images/galeria-chica-3.jpg" alt="Miniatura 3" loading="lazy" />
      <img class="galeria-thumb" src="/images/galeria-chica-2.jpg" alt="Miniatura 4" loading="lazy" />
      <img class="galeria-thumb" src="/images/galeria-chica-5.jpg" alt="Miniatura 5" loading="lazy" />
    </div>
  </section>

  <section class="instagram-preview container" aria-label="Vista previa de Instagram">
    <h2 class="reveal">Instagram</h2>
    <div class="instagram-preview-card reveal reveal-delay-1">
      <a
        href="https://www.instagram.com/oaxacaviveshow/"
        target="_blank"
        rel="noopener"
        class="instagram-cta instagram-cta-top"
      >
        Sigue a Oaxaca Vive Show en Instagram
      </a>

      <div class="instagram-preview-grid" role="list">
        <a href="https://www.instagram.com/oaxacaviveshow/" target="_blank" rel="noopener" role="listitem" aria-label="Post de Instagram 1">
          <img src="/images/galeria-chica-1.jpg" alt="Preview de publicación de Instagram 1" loading="lazy" width="180" height="180" />
        </a>
        <a href="https://www.instagram.com/oaxacaviveshow/" target="_blank" rel="noopener" role="listitem" aria-label="Post de Instagram 2">
          <img src="/images/galeria-chica-2.jpg" alt="Preview de publicación de Instagram 2" loading="lazy" width="180" height="180" />
        </a>
        <a href="https://www.instagram.com/oaxacaviveshow/" target="_blank" rel="noopener" role="listitem" aria-label="Post de Instagram 3">
          <img src="/images/galeria-chica-3.jpg" alt="Preview de publicación de Instagram 3" loading="lazy" width="180" height="180" />
        </a>
        <a href="https://www.instagram.com/oaxacaviveshow/" target="_blank" rel="noopener" role="listitem" aria-label="Post de Instagram 4">
          <img src="/images/galeria-chica-5.jpg" alt="Preview de publicación de Instagram 4" loading="lazy" width="180" height="180" />
        </a>
        <a href="https://www.instagram.com/oaxacaviveshow/" target="_blank" rel="noopener" role="listitem" aria-label="Post de Instagram 5">
          <img src="/images/galeria-4.jpg" alt="Preview de publicación de Instagram 5" loading="lazy" width="180" height="180" />
        </a>
      </div>

      <a
        href="https://www.instagram.com/oaxacaviveshow/"
        target="_blank"
        rel="noopener"
        class="instagram-cta instagram-cta-bottom"
      >
        Ver más publicaciones
      </a>
    </div>
  </section>

  <section class="promo-video-section">
    <div class="promo-video-grid container">
      <div class="promo-video-copy reveal">
        <h2>Mas de 80 artistas, una sola celebracion escenica</h2>
        <p class="promo-video-lead">
          Oaxaca Vive es una produccion multidisciplinaria que recorre la riqueza
          cultural de Oaxaca a traves de la musica, la danza, el teatro, la narrativa
          y las artes visuales.
        </p>
        <p>
          El espectaculo reune voces, orquesta, elenco actoral y un equipo creativo
          que proyecta la fuerza y el legado de los pueblos indigenas y afrodescendientes
          del estado.
        </p>
      
      </div>
      <div class="promo-video-frame reveal reveal-delay-1">
        <video
          class="promo-video-vertical"
          data-defer-video
          muted
          playsinline
          preload="none"
          poster="/images/galeria-1.jpg"
        >
          <source
            data-src="/video/OAXACA%20VIVE_PROMOCIONAL%20VERTICAL_01.mp4"
            type="video/mp4"
          />
        </video>
      </div>
    </div>
  </section>

  <section class="separador-video">
    <video class="separador-video-bg" data-defer-video muted playsinline preload="none" poster="/images/stage-bg.jpg">
      <source data-src="/video/high-teatro.mp4" type="video/mp4" />
    </video>
    <div class="separador-video-overlay"></div>
    <h2 class="separador-video-texto">
      Un encuentro donde las raíces se hermanan y festejan.
    </h2>
  </section>



  <section
    class="frame-fiesta"
    style="background-image: url('/images/stage-bg.jpg');"
  >
    <div class="frame-fiesta-contenido">
      <h2>"Vive la cultura, únete a la fiesta"</h2>
      <a
        href="https://www.instagram.com/oaxacaviveshow"
        target="_blank"
        rel="noopener"
        class="btn btn-secondary">Conócenos</a
      >
    </div>
  </section>
</Layout>

<script>
  function initHeroVideo() {
    const heroVideo = document.getElementById("hero-main-video") as HTMLVideoElement | null;
    if (!heroVideo) return;

    heroVideo.muted = true;
    heroVideo.defaultMuted = true;
    heroVideo.playsInline = true;

    if (heroVideo.currentTime < 0.1) {
      heroVideo.currentTime = 0.1;
    }

    heroVideo.play().catch(() => {
      // Algunos navegadores retrasan el autoplay hasta que haya interacción.
    });
  }

  function initGaleria() {
    const principal = document.getElementById(
      "galeria-img-principal"
    ) as HTMLImageElement | null;
    const thumbs = document.querySelectorAll<HTMLImageElement>(".galeria-thumb");
    if (!principal || thumbs.length === 0) return;

    thumbs[0].classList.add("selected");

    thumbs.forEach((thumb) => {
      if (thumb.dataset.bound === "1") return;
      thumb.dataset.bound = "1";
      thumb.addEventListener("click", () => {
        principal.src = thumb.src;
        thumbs.forEach((t) => t.classList.remove("selected"));
        thumb.classList.add("selected");
      });
    });
  }

  function initDeferredVideos() {
    const videos = document.querySelectorAll<HTMLVideoElement>("video[data-defer-video]");
    if (videos.length === 0) return;

    const loadAndPlay = (video: HTMLVideoElement) => {
      const source = video.querySelector("source[data-src]") as HTMLSourceElement | null;
      if (!source || source.src) return;

      source.src = source.dataset.src || "";
      video.load();
      video.autoplay = true;
      video.loop = true;
      video.play().catch(() => {
        // Si el navegador bloquea autoplay, el usuario puede iniciarlo al interactuar.
      });
    };

    if (!("IntersectionObserver" in window)) {
      videos.forEach(loadAndPlay);
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const video = entry.target as HTMLVideoElement;
          loadAndPlay(video);
          observer.unobserve(video);
        });
      },
      { rootMargin: "200px 0px" }
    );

    videos.forEach((video) => observer.observe(video));
  }

  document.addEventListener("astro:page-load", initHeroVideo);
  document.addEventListener("astro:page-load", initGaleria);
  document.addEventListener("astro:page-load", initDeferredVideos);
</script>
