---
// Botón flotante fijo, visible en todas las páginas.
// Enlaza directo a la línea de WhatsApp para boletos.
import { WHATSAPP_URL } from "../config";
---

<a
  class="whatsapp-cta"
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Comprar boletos por WhatsApp"
>
  <img src="/icons/logowhats.png" alt="" aria-hidden="true" />
  <span class="cta-text">Boletos</span>
</a>
