---
// Componente de pantalla de carga con animaciones
---

<div id="loading-screen" class="loading-screen" style="display: none;">
  <div class="loading-container">
    <!-- Logo principal -->
    <img
      src="/images/logo.png"
      alt="Oaxaca Vive"
      class="loading-logo"
    />

    <!-- Texto de carga -->
    <div class="loading-text">
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="dot"></span>
    </div>
  </div>
</div>

<script>
  let hideTimeout = null;

  function getLoadingScreen() {
    return document.getElementById('loading-screen');
  }

  function showLoadingScreen() {
    const loadingScreen = getLoadingScreen();
    if (!loadingScreen) return;

    if (hideTimeout) {
      clearTimeout(hideTimeout);
      hideTimeout = null;
    }

    loadingScreen.style.display = 'flex';
    loadingScreen.classList.remove('fade-out');
  }

  function hideLoadingScreen(delay = 700) {
    const loadingScreen = getLoadingScreen();
    if (!loadingScreen) return;

    if (hideTimeout) {
      clearTimeout(hideTimeout);
    }

    hideTimeout = setTimeout(() => {
      loadingScreen.classList.add('fade-out');
      setTimeout(() => {
        loadingScreen.style.display = 'none';
      }, 600);
    }, delay);
  }

  // Muestra el loading antes de cada navegación con ClientRouter.
  document.addEventListener('astro:before-preparation', showLoadingScreen);

  // Oculta el loading cuando la página termina de cargar.
  document.addEventListener('astro:page-load', () => hideLoadingScreen(250));
</script>
